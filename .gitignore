# This repository lives inside a working comic library, so it tracks by allowlist rather than by
# exclusion. Anything not named below - the comic folders, the .cbz archives, a personal comics.csv -
# stays out, and git never has to walk tens of gigabytes to work that out.
*

!.gitignore
!.gitattributes
!.dockerignore
!README.md
!CLAUDE.md
!NOTICE
!LICENSE
!requirements.txt
!requirements-dev.txt
!pytest.ini

# the suite. two lines each, because * matches at every depth: the folder has to be let in before its
# files can be, and anything not named here - __pycache__, a stray screenshot - stays out
!tests/
!tests/*.py

!mirror_base.py
!update_comics.py
!adopt_comic.py
!chapters.py

# what the scripts share. two lines, because * matches at every depth: the folder first, then its files
!comiclib/
!comiclib/*.py
!comiclib/chapters/
!comiclib/chapters/*.py
!comiclib/web/
!comiclib/web/*.py
!comiclib/adopt/
!comiclib/adopt/*.py
!web_ui.py

# the page itself, which web_ui serves file by file: the same two lines for each folder in it
!web_page/
!web_page/*.html
!web_page/css/
!web_page/css/*.css
!web_page/js/
!web_page/js/*.js

!Dockerfile
!docker-compose.yml

# the reader, a program of its own with its own image and its own test suite. the same two lines per
# folder; node_modules and the built dist/ are never named, so they stay out
!reader/
!reader/Dockerfile
!reader/docker-compose.yml
!reader/pytest.ini
!reader/requirements.txt
!reader/requirements-dev.txt
!reader/comicreader/
!reader/comicreader/*.py
!reader/tests/
!reader/tests/*.py
!reader/web/
!reader/web/index.html
!reader/web/package.json
!reader/web/package-lock.json
!reader/web/tsconfig.json
!reader/web/vite.config.ts
!reader/web/public/
!reader/web/public/*
!reader/web/src/
!reader/web/src/*.ts
!reader/web/src/*.css
!comics.example.csv
